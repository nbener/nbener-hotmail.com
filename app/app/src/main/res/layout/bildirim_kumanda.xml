        <TextView android:id="@+id/b_arka" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_margin="3dp" android:gravity="center" android:textSize="13sp" android:textColor="#0B2B33" android:textStyle="bold" android:background="@drawable/bildirim_dugme" android:text="Arka plan"/>
